# Drake AI production stack
# Copy this file to .env on the server that runs docker-compose.prod.yml.
# Use one shared backend and one shared PostgreSQL database for both admin and user domains.

# Public domains
USER_APP_URL=https://user.your-domain.com
ADMIN_APP_URL=https://admin.your-domain.com
API_URL=https://api.your-domain.com
VITE_API_URL=https://api.your-domain.com
USER_DASHBOARD_PORT=80
ADMIN_DASHBOARD_PORT=8080

# PostgreSQL database used by admin-created credentials, user module access, projects, and user activity history.
POSTGRES_DB=drakeai
POSTGRES_USER=drakeai
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://drakeai:CHANGE_THIS_STRONG_POSTGRES_PASSWORD@postgres:5432/drakeai

# Redis session/cache store
REDIS_URL=redis://redis:6379/0

# JWT auth. Use one identical SECRET_KEY for admin dashboard, user dashboard, and backend.
SECRET_KEY=CHANGE_THIS_TO_A_64_PLUS_CHARACTER_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin account seeded by backend startup.
ADMIN_USERNAME=Drake6105
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=Admin

# Object/file storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=drakeai_minio
MINIO_SECRET_KEY=CHANGE_THIS_STRONG_MINIO_PASSWORD
MINIO_BUCKET=drakeai-files
MINIO_USE_SSL=false

# Drake Assistant / SLM-GPT language model integrations
ANTHROPIC_API_KEY=
VLLM_API_KEY=EMPTY
VLLM_CHAT_BASE_URL=http://vllm-chat:8000/v1
VLLM_EMBEDDING_BASE_URL=http://vllm-embedding:8001/v1
LLM_MODEL=qwen2.5-7b-instruct
VLLM_TIMEOUT_SECONDS=120

# Drake OCR vision endpoint. If this is not running, the backend uses local RapidOCR fallback.
VLLM_OCR_BASE_URL=http://vllm-ocr:8700/v1
VLLM_OCR_MODEL=qwen2.5-vl-7b

# CORS must include both deployed frontend domains.
CORS_ORIGINS=["https://user.your-domain.com","https://admin.your-domain.com","https://api.your-domain.com"]

APP_ENV=production
DEBUG=false
