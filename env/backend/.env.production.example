# Drake AI backend production environment
# Copy to backend/.env for a non-Docker backend deployment.

DATABASE_URL=postgresql://drakeai:CHANGE_THIS_STRONG_POSTGRES_PASSWORD@127.0.0.1:5432/drakeai
REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY=CHANGE_THIS_TO_A_64_PLUS_CHARACTER_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seeded admin login. Admin-created users are stored in the same users table.
ADMIN_USERNAME=Drake6105
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=Admin

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=drakeai_minio
MINIO_SECRET_KEY=CHANGE_THIS_STRONG_MINIO_PASSWORD
MINIO_BUCKET=drakeai-files
MINIO_USE_SSL=false

# Assistant / RAG / Drake SLM-GPT
ANTHROPIC_API_KEY=
VLLM_API_KEY=EMPTY
VLLM_CHAT_BASE_URL=http://127.0.0.1:8000/v1
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen2.5-7b-instruct
VLLM_TIMEOUT_SECONDS=120

# Drake OCR. Keep configured for vLLM vision; local RapidOCR fallback is available when this endpoint is down.
VLLM_OCR_BASE_URL=http://127.0.0.1:8700/v1
VLLM_OCR_MODEL=qwen2.5-vl-7b

# Add every deployed dashboard domain here.
CORS_ORIGINS=["https://user.your-domain.com","https://admin.your-domain.com","http://127.0.0.1:3000"]

APP_ENV=production
DEBUG=false
