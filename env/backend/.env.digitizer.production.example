# Drake AI Digitizer endpoint environment
# Merge these values into backend/.env or the backend service environment.
# These endpoints power Drake SLM/GPT and Drake OCR.

VLLM_API_KEY=EMPTY

# Drake SLM/GPT answer generation endpoint
VLLM_CHAT_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen2.5-7b-instruct

# Optional embedding endpoint for future semantic indexing
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1

# Drake OCR vision endpoint. Local RapidOCR fallback works when this service is unavailable.
VLLM_OCR_BASE_URL=http://127.0.0.1:8700/v1
VLLM_OCR_MODEL=qwen2.5-vl-7b

VLLM_TIMEOUT_SECONDS=120
